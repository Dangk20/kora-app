// KORA — esquema de datos
// Las tres decisiones que sostienen el sistema (ver tech/plan-tecnico-ejecucion-kora.md §2):
//   1. El inventario es un libro contable append-only (stock_movements); variants.stock_actual
//      es una columna materializada que SOLO se modifica en la misma transacción que inserta
//      el movimiento.
//   2. Toda venta pasa por una única función transaccional con SELECT ... FOR UPDATE.
//   3. order.confirmed es el evento central; se propaga vía outbox (domain_events).
// Decisión cerrada jul 2026: el stock solo se descuenta al confirmar (sin reserva).
// Los reasons RESERVA / LIBERACION_RESERVA quedan definidos para activarse sin migración.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// AUTH / RBAC
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements  StockMovement[]
  confirmedOrders Order[]              @relation("OrderConfirmedBy")
  statusChanges   OrderStatusHistory[]
  campaigns       Campaign[]

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // admin, operador, cajero, marketing
  description String?
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

// Matriz módulo × acción. Ej: (catalog, edit), (orders, confirm), (pos, sell)
model Permission {
  id     String @id @default(cuid())
  module String // catalog | inventory | orders | pos | crm | dashboard | loyalty | marketing | users | settings
  action String // view | create | edit | delete | confirm | export | sell | adjust

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────
// CATÁLOGO
// ─────────────────────────────────────────────────────────────

model Category {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  parentId     String?
  parent       Category?        @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]       @relation("CategoryTree")
  position     Int              @default(0)
  active       Boolean          @default(true)
  // Identidad visual de la categoría (patrón del prototipo aprobado):
  // fondo pastel del tile + ícono lucide. Los tiles de producto la heredan
  // mientras no haya fotos reales.
  color        String           @default("#FBE3D3")
  icon         String           @default("package")
  products     Product[]
  couponScopes CouponCategory[]

  @@map("categories")
}

model Product {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  description   String?
  brand         String?
  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id])
  active        Boolean         @default(true)
  featured      Boolean         @default(false)
  images        ProductImage[]
  variants      Variant[]
  showcaseItems ShowcaseItem[]
  banners       Banner[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  couponScopes  CouponProduct[]

  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String // key en R2; nunca se sirve desde el VPS
  alt       String?
  position  Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

// La unidad vendible. Los 4 precios: (COP|USD) × (tienda|online).
model Variant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String  @unique
  name       String // "Talla M / Rojo"; para producto simple, "Única"
  attributes Json? // { talla: "M", color: "Rojo" }
  barcode    String? @unique

  priceCopStore  Decimal @db.Decimal(12, 2)
  priceCopOnline Decimal @db.Decimal(12, 2)
  priceUsdStore  Decimal @db.Decimal(12, 2)
  priceUsdOnline Decimal @db.Decimal(12, 2)

  // Materializado. SOLO lo modifica la función transaccional de inventario.
  stockActual Int     @default(0)
  // Asignación de canal (patrón del prototipo): cuántas unidades del stock
  // total están publicadas online. Física = stockActual - onlineUnits.
  // NO es un segundo stock: es una regla de visibilidad sobre el mismo pool.
  // Invariante: 0 <= onlineUnits <= stockActual (el motor la mantiene).
  onlineUnits Int     @default(0)
  stockMin    Int     @default(0) // umbral de alerta "quedan pocas unidades"
  active      Boolean @default(true)

  stockMovements StockMovement[]
  orderItems     OrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  freeInCoupons  Coupon[]        @relation("CouponFreeVariant")

  @@index([productId])
  @@map("variants")
}

// ─────────────────────────────────────────────────────────────
// INVENTARIO — libro contable append-only
// ─────────────────────────────────────────────────────────────

enum StockReason {
  COMPRA_INICIAL
  VENTA_ONLINE
  VENTA_POS
  AJUSTE_MANUAL
  DEVOLUCION
  MERMA
  RESERVA // definidos pero inactivos: decisión "sin reserva" (jul 2026)
  LIBERACION_RESERVA
}

enum SaleChannel {
  WEB
  POS
  ADMIN
  SYSTEM
}

model StockMovement {
  id        String      @id @default(cuid())
  variantId String
  variant   Variant     @relation(fields: [variantId], references: [id])
  delta     Int // positivo entra, negativo sale. Nunca se actualiza ni borra.
  reason    StockReason
  channel   SaleChannel
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id])
  orderId   String?
  order     Order?      @relation(fields: [orderId], references: [id])
  note      String?
  createdAt DateTime    @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────
// CLIENTES (CRM)
// ─────────────────────────────────────────────────────────────

enum CustomerSource {
  WEB
  POS
  IMPORT
  MANUAL
}

model Customer {
  id               String         @id @default(cuid())
  name             String
  phone            String?        @unique // canal principal: WhatsApp
  email            String?        @unique
  document         String? // cédula/NIT, opcional
  country          String         @default("CO")
  city             String?
  address          String?
  source           CustomerSource @default(WEB)
  acceptsMarketing Boolean        @default(false) // Habeas Data: opt-in explícito
  unsubscribedAt   DateTime?

  // Correo utilizable. Un rebote duro lo pone en false: seguir escribiendo a
  // direcciones que rebotan es la forma más rápida de que un proveedor
  // clasifique el dominio como spam.
  emailUsable Boolean @default(true)

  // Saldo de Kora Cashback materializado desde cashback_movements (mismo patrón
  // que el stock): es la CONSECUENCIA del libro, no un número que se edite.
  // Dos bolsas separadas porque no existe tasa de cambio en KORA y es deliberado:
  // sumarlas daría un número sin significado que además parecería correcto.
  cashbackCop Decimal @default(0) @db.Decimal(12, 2)
  cashbackUsd Decimal @default(0) @db.Decimal(12, 2)

  // ── Cuenta de la tienda ──
  // La credencial cuelga del cliente y no de una tabla aparte: así,
  // registrarse con un correo que ya compró como invitado es PONERLE
  // CONTRASEÑA a un cliente que ya existe, y su historial y su cashback
  // aparecen solos. Nulo = compró como invitado y nunca creó cuenta.
  passwordHash   String?
  accountActive  Boolean   @default(true)
  accountCreated DateTime?

  orders             Order[]
  cashbackMovements  CashbackMovement[]
  sessions           BuyerSession[]
  couponRedemptions  CouponRedemption[]
  campaignRecipients CampaignRecipient[]
  consentEvents      ConsentEvent[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("customers")
}

// ─────────────────────────────────────────────────────────────
// PEDIDOS — order.confirmed es el evento central del sistema
// ─────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING // armado en la web, enviado por WhatsApp; NO descuenta stock
  CONFIRMED // el operador confirmó el pago → descuenta stock, dispara efectos
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum Currency {
  COP
  USD
}

model Order {
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement()) // código humano: KORA-000123

  channel  SaleChannel // WEB o POS (POS nace y se confirma en el mismo acto)
  status   OrderStatus @default(PENDING)
  currency Currency    @default(COP)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  subtotal      Decimal @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  // Cuánto de este pedido se pagó con saldo de Kora Cashback. Parte del
  // snapshot inmutable: es lo que el operador cobró, y tiene que sobrevivir
  // aunque el libro de cashback se reorganice. QUÉ lotes lo pagaron no se
  // copia aquí — ya está en cashback_movements, apuntando a este pedido.
  cashbackApplied Decimal @default(0) @db.Decimal(12, 2)

  couponRedemption CouponRedemption?
  whatsappMessage  String? // mensaje pre-armado (se envía por api.whatsapp.com/send)
  note             String?

  // ── Snapshot del comprador y la entrega (PED_HU001/002) ──
  // Viven en el pedido, no solo en el cliente: si el cliente cambia de
  // dirección después, el pedido despachado conserva la suya.
  contactName     String?
  contactPhone    String? // E.164: +57… / +1…
  contactEmail    String?
  contactDocument String? // CC/CE/NIT — lo exigen las transportadoras (solo CO)

  shipCountry      String? @default("CO") // CO | US
  shipState        String? // departamento (CO) | estado (US)
  shipCity         String?
  shipAddress      String?
  shipAddress2     String? // apto/torre/conjunto | Apt/Suite
  shipNeighborhood String? // barrio (solo CO)
  shipZip          String? // ZIP (solo US)
  shipNotes        String?

  paymentPreference String? // Nequi, Zelle… (administrable a futuro)

  // Vigencia del pedido pendiente (PED_HU003: expira a las 2 h).
  expiresAt DateTime?

  // Idempotencia del checkout (PED_HU002): doble clic no crea dos pedidos.
  checkoutToken String? @unique

  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?     @relation("OrderConfirmedBy", fields: [confirmedById], references: [id])

  items             OrderItem[]
  emailsSent        OrderEmail[]
  stockMovements    StockMovement[]
  statusHistory     OrderStatusHistory[]
  cashbackMovements CashbackMovement[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])

  qty       Int
  unitPrice Decimal @db.Decimal(12, 2) // precio al momento de la venta
  total     Decimal @db.Decimal(12, 2)

  // Snapshots: el historial no cambia si el catálogo cambia
  productName String
  variantName String
  sku         String

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from      OrderStatus
  to        OrderStatus
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id])
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

// ─────────────────────────────────────────────────────────────
// CUPONES
// ─────────────────────────────────────────────────────────────

enum CouponType {
  PERCENT
  FIXED
  FREE_PRODUCT // adaptación KORA del patrón "días gratis" (decisión 19 jul 2026)
}

// A qué productos aplica el descuento.
enum CouponScope {
  ALL
  CATEGORIES
  PRODUCTS
}

model Coupon {
  id          String  @id @default(cuid())
  // Inmutable después de crear: es lo que el comprador escribe y lo que queda
  // registrado en los pedidos. Cambiarlo dejaría campañas impresas apuntando
  // a nada y pedidos históricos apuntando a otro significado.
  code        String  @unique
  name        String // nombre interno, solo visible en el panel
  description String?

  type CouponType

  // PERCENT: 1..100
  percentValue Decimal? @db.Decimal(5, 2)

  // FIXED: un importe POR MONEDA, ambos opcionales. Dos columnas y no una con
  // moneda porque el cliente pidió cupones aplicables a las dos a la vez, y
  // porque NO hay conversión: son dos importes decididos por el negocio, no
  // uno derivado del otro.
  amountCop Decimal? @db.Decimal(12, 2)
  amountUsd Decimal? @db.Decimal(12, 2)

  // FREE_PRODUCT: la variante que se regala.
  freeVariantId String?
  freeVariant   Variant? @relation("CouponFreeVariant", fields: [freeVariantId], references: [id])

  minSubtotal      Decimal?  @db.Decimal(12, 2)
  maxUses          Int? // null = ilimitado
  usedCount        Int       @default(0)
  perCustomerLimit Int?      @default(1)
  validFrom        DateTime?
  validTo          DateTime?

  // Los cupones NO se eliminan (los pedidos los referencian): pausar es la
  // única forma de sacarlos de circulación.
  active Boolean @default(true)

  // Solo para clientes sin pedidos confirmados previos.
  firstPurchaseOnly  Boolean @default(false)
  // OFF = los ítems ya rebajados quedan FUERA del cálculo del descuento.
  appliesToSaleItems Boolean @default(true)

  scope      CouponScope      @default(ALL)
  categories CouponCategory[]
  products   CouponProduct[]

  redemptions CouponRedemption[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("coupons")
}

// El alcance va como RELACIÓN y no como lista de identificadores en un campo
// de texto: así la base garantiza que un cupón no apunta a algo borrado, y la
// consulta de elegibilidad es un join en vez de una lista que hay que recorrer.
model CouponCategory {
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@map("coupon_categories")
}

model CouponProduct {
  couponId  String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@map("coupon_products")
}

model CouponRedemption {
  id         String    @id @default(cuid())
  couponId   String
  coupon     Coupon    @relation(fields: [couponId], references: [id])
  orderId    String    @unique
  order      Order     @relation(fields: [orderId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  amount     Decimal   @db.Decimal(12, 2) // descuento efectivamente aplicado
  createdAt  DateTime  @default(now())

  @@index([couponId])
  @@map("coupon_redemptions")
}

// ─────────────────────────────────────────────────────────────
// SESIÓN DEL COMPRADOR — deliberadamente NO es Auth.js
//
// Los operadores se autentican con Auth.js contra `users`. El comprador NO,
// y la separación es el punto: si compartieran mecanismo, la protección del
// panel dependería de que toda ruta futura se acordara de mirar una marca en
// el token, y una que se olvide es un comprador confirmando pedidos. Con
// cookie y camino de verificación distintos, la ruta nueva del panel es
// segura por omisión.
//
// Opaca y en la base porque un JWT no se puede retirar: cerrar sesión debe
// surtir efecto YA, y detrás de esta cuenta hay saldo gastable. Es la misma
// decisión que rige requirePermission(), que verifica contra la base.
// ─────────────────────────────────────────────────────────────

model BuyerSession {
  id String @id @default(cuid())

  // El HASH del identificador que viaja en la cookie, nunca el identificador.
  // Quien pueda leer esta tabla no puede suplantar a nadie con lo que ve —
  // mismo criterio que las contraseñas, y por el mismo motivo.
  tokenHash String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String? // solo diagnóstico
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt]) // barrido de caducadas
  @@map("buyer_sessions")
}

// ─────────────────────────────────────────────────────────────
// KORA CASHBACK — mismo patrón contable que el inventario, pero con DINERO
//
// Un libro por LOTES: cada acreditación nace con su moneda, su pedido de
// origen, su vencimiento a 12 meses y su remanente. Consumos y vencimientos
// son movimientos negativos que apuntan al lote que agotan. Sin lotes no
// habría forma de saber qué parte del saldo caduca el mes que viene.
// ─────────────────────────────────────────────────────────────

enum CashbackType {
  EARN // acredita sobre order.confirmed — es el único que abre lote
  REDEEM // gasta saldo en una compra
  EXPIRE // el lote cumplió 12 meses
  ADJUST // corrección manual, siempre con nota
}

model CashbackMovement {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  delta    Decimal      @db.Decimal(12, 2) // positivo acredita, negativo consume/vence
  currency Currency // las dos bolsas nunca se suman ni se convierten
  type     CashbackType

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  // Solo en los lotes (type = EARN): cuánto queda sin gastar y cuándo caduca.
  // Se baja al consumir; vencer lo lleva a cero mediante un movimiento EXPIRE,
  // nunca borrando el lote: el libro tiene que seguir explicando el saldo.
  remaining Decimal?  @db.Decimal(12, 2)
  expiresAt DateTime?

  // A qué lote agota este consumo o vencimiento.
  sourceMovementId String?
  sourceMovement   CashbackMovement?  @relation("CashbackLote", fields: [sourceMovementId], references: [id])
  consumptions     CashbackMovement[] @relation("CashbackLote")

  note      String?
  createdAt DateTime @default(now())

  @@index([customerId, currency, createdAt])
  @@index([currency, expiresAt]) // barrido del vencimiento
  @@index([orderId, type]) // idempotencia: ¿ya hay lote de este pedido?
  // Además, en migración: índice único PARCIAL `cashback_un_lote_por_pedido`
  // sobre (orderId) WHERE type = 'EARN'. No se puede expresar aquí, pero es la
  // garantía real de que un pedido no acredita dos veces: la comprobación del
  // manejador no es atómica y lo que se duplicaría es dinero.
  @@map("cashback_movements")
}

// ─────────────────────────────────────────────────────────────
// EMAIL REMARKETING
// ─────────────────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

model Campaign {
  id     String         @id @default(cuid())
  name   String // interno: solo lo ve el panel
  status CampaignStatus @default(DRAFT)

  // ── Contenido (bloques editables mientras es borrador) ──
  // Sin HTML libre: decisión del cliente del 19 jul 2026. Solo plantilla de
  // marca, que es también la única forma de que un correo no se rompa.
  subject    String
  preheader  String?
  title      String
  body       String   @db.Text
  imageKey   String? // en R2: un cliente de correo pide la imagen desde fuera
  ctaLabel   String?
  ctaUrl     String?
  productIds String[] // 0–6 destacados, resueltos al renderizar

  // ── Audiencia ──
  segment Json // filtros combinables; se recalculan si la campaña está programada

  // ── Copia inmutable ──
  // Al enviar se renderiza UNA vez y se guarda el resultado. Enviado, lo que
  // hace falta no son los campos sino lo que se mandó, tal cual: un producto
  // que cambia de precio no puede alterar un correo que ya salió.
  sentHtml String? @db.Text
  sentText String? @db.Text

  scheduledAt   DateTime?
  sendStartedAt DateTime?
  sentAt        DateTime?

  // Contadores materializados: el detalle no cuenta filas en caliente.
  sentCount        Int @default(0)
  failedCount      Int @default(0)
  unsubscribeCount Int @default(0)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  recipients CampaignRecipient[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([status, createdAt])
  @@map("campaigns")
}

enum RecipientStatus {
  PENDING // en la lista congelada, todavía sin tocar
  SENDING // RESERVADO por un despachador, antes de llamar al proveedor
  SENT
  FAILED
  SKIPPED // se dio de baja o su correo dejó de ser utilizable a mitad del envío
}

model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Copia del correo al congelar la lista: el cliente puede corregirlo después
  // y el registro tiene que decir a dónde se envió de verdad.
  email  String
  name   String
  status RecipientStatus @default(PENDING)

  // La reserva ocurre ANTES de llamar al proveedor: si el proceso muere entre
  // reservar y enviar, el peor caso es que alguien NO reciba el correo. Al
  // revés, el peor caso sería que lo reciba dos veces — y eso no se deshace.
  reservedAt DateTime?
  sentAt     DateTime?
  attempts   Int       @default(0)
  error      String?
  providerId String? // identificador del mensaje en el proveedor

  @@unique([campaignId, customerId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// ─────────────────────────────────────────────────────────────
// CONSENTIMIENTO — Ley 1581 (CO) y CAN-SPAM (US)
//
// Un booleano no responde "¿con qué autorización le escribieron?". Cada
// cambio deja su fila con fecha y origen, y nunca se sobrescribe en silencio.
// ─────────────────────────────────────────────────────────────

enum ConsentSource {
  CHECKOUT // aceptó al hacer un pedido
  MANUAL // alta desde el panel
  UNSUBSCRIBE_LINK // se dio de baja desde el correo
  RESUBSCRIBE // volvió a suscribirse, por decisión propia
  SPAM_COMPLAINT // queja: baja inmediata
  BOUNCE // rebote duro: el correo deja de ser utilizable
}

model ConsentEvent {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscribed Boolean // el estado al que se pasó
  source     ConsentSource
  note       String?
  createdAt  DateTime      @default(now())

  @@index([customerId, createdAt])
  @@map("consent_events")
}

// ─────────────────────────────────────────────────────────────
// CONTENIDO DE TIENDA
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// VITRINA — la página de inicio de la tienda, administrable
//
// Las secciones son FIJAS (las del prototipo aprobado): el operador elige
// qué va en cada una, puede ocultarlas, pero no crear ni reordenar. Cada
// sección se llena a mano o sola con una regla.
// ─────────────────────────────────────────────────────────────

enum ShowcaseMode {
  MANUAL // el operador elige los productos uno a uno
  AUTO // se llena sola con `autoRule`
}

enum ShowcaseRule {
  BEST_SELLERS // más vendidos (por unidades confirmadas)
  NEWEST // agregados recientemente
  ONLINE_DEAL // con precio especial online activo
  FEATURED // marcados como destacados en el catálogo
}

model ShowcaseSection {
  /**
   * Clave estable de la sección; la UI conoce estas claves.
   */
  key      String       @id
  title    String
  subtitle String?
  active   Boolean      @default(true)
  mode     ShowcaseMode @default(MANUAL)
  autoRule ShowcaseRule @default(NEWEST)
  /**
   * Cuántos productos muestra la sección.
   */
  limit    Int          @default(4)

  items     ShowcaseItem[]
  updatedAt DateTime       @updatedAt

  @@map("showcase_sections")
}

model ShowcaseItem {
  id         String          @id @default(cuid())
  sectionKey String
  section    ShowcaseSection @relation(fields: [sectionKey], references: [key], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  position   Int             @default(0)

  @@unique([sectionKey, productId])
  @@index([sectionKey, position])
  @@map("showcase_items")
}

/**
 * Pieza publicitaria de la vitrina. La imagen viene ya diseñada con su texto
 * (decisión 19 jul 2026): el sistema solo la muestra y la enlaza.
 * `slot` la ancla a su lugar en la página (hero principal, hero lateral…).
 * Un mismo slot admite VARIAS piezas: la tienda las rota automáticamente en
 * el orden de `position`.
 */
model Banner {
  id        String    @id @default(cuid())
  slot      String
  title     String
  /**
   * Key en el storage (R2 en prod, disco en dev) — nunca una URL absoluta.
   */
  imageUrl  String?
  /**
   * Producto al que lleva el banner.
   */
  productId String?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  /**
   * Enlace libre, si no apunta a un producto.
   */
  linkUrl   String?
  position  Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  updatedAt DateTime  @updatedAt

  @@index([slot, position])
  @@index([productId])
  @@map("banners")
}

// Configuración operable (WhatsApp de la tienda, reglas de negocio, etc.)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}


// ─────────────────────────────────────────────────────────────
// CORREOS TRANSACCIONALES — el registro de lo ya enviado
//
// Existe para que un correo no salga dos veces. La entrega de la bandeja de
// salida es *al menos una vez*, así que un evento puede llegar repetido: un
// comprador que recibe dos confirmaciones duda de si hizo dos pedidos, y un
// operador que recibe dos avisos de "pedido nuevo" empieza a ignorarlos —y el
// día que llegue uno de verdad, no lo verá.
//
// La fila se escribe ANTES de entregar al proveedor. Si algo falla en medio, el
// peor caso es que alguien no reciba un correo; nunca que lo reciba dos veces.
// ─────────────────────────────────────────────────────────────

enum OrderEmailType {
  BUYER_CREATED // al comprador: pedido recibido, con el enlace de WhatsApp
  BUYER_CONFIRMED // al comprador: pago confirmado y cashback acreditado
  BUYER_SHIPPED // al comprador: pedido enviado
  BUYER_CANCELLED // al comprador: cancelado o expirado
  STAFF_NEW_ORDER // al operador: entró un pedido
}

model OrderEmail {
  id      String         @id @default(cuid())
  orderId String
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type    OrderEmailType

  to     String
  sentAt DateTime? // nulo = reservado pero todavía no entregado

  // Quién lo está intentando ahora. Sin esto, un fallo del proveedor dejaría
  // la reserva puesta y el reintento la leería como "ya enviado": el correo no
  // saldría nunca. Con la marca, el reintento puede retomarlo, y dos procesos
  // a la vez no pueden porque la toma es una escritura condicional.
  claimedAt DateTime?
  attempts  Int       @default(0)

  providerId String? // identificador del proveedor, para diagnosticar
  error      String? // último fallo, si lo hubo
  createdAt  DateTime @default(now())

  // LA garantía: un correo por pedido y tipo. No una comprobación previa —
  // dos trabajadores pueden mirar a la vez y ver ambos que no está.
  @@unique([orderId, type])
  @@index([sentAt])
  @@map("order_emails")
}

// ─────────────────────────────────────────────────────────────
// OUTBOX — nada que cuelgue de order.confirmed se pierde
// ─────────────────────────────────────────────────────────────

// PENDING    esperando; se toma cuando llega su nextAttemptAt
// PROCESSING tomado por un trabajador (claimedAt marca desde cuándo)
// PROCESSED  terminado con éxito
// FAILED     MUERTO: agotó sus intentos. Terminal, no se vuelve a tomar.
//            Un fallo intermedio NO deja el evento aquí: vuelve a PENDING con
//            el contador aumentado. FAILED significa únicamente "muerto", que
//            es lo que la observabilidad necesita poder distinguir.
enum EventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model DomainEvent {
  id      String      @id @default(cuid())
  type    String // "order.confirmed", ...
  payload Json
  status  EventStatus @default(PENDING)

  // Cuándo puede volver a tomarse. Sin esto, un evento que falla se retoma en
  // el ciclo siguiente sin ninguna espera: un bucle cerrado contra una
  // dependencia caída. La espera crece con cada intento.
  nextAttemptAt DateTime @default(now())

  // Cuándo lo tomó un trabajador. Si supera el umbral se considera huérfano de
  // un proceso muerto y vuelve a PENDING — sin esto, un evento tomado por un
  // proceso que murió se queda en PROCESSING para siempre.
  claimedAt DateTime?

  attempts    Int       @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  // Índice de la consulta de toma: filtra por estado y por si ya llegó su turno.
  @@index([status, nextAttemptAt])
  // Para recuperar huérfanos y para el diagnóstico.
  @@index([status, claimedAt])
  @@index([status, createdAt])
  @@map("domain_events")
}

// ─────────────────────────────────────────────────────────────
// TRABAJOS PROGRAMADOS
// ─────────────────────────────────────────────────────────────

// SUCCESS  terminó bien
// FAILURE  lanzó, o superó su tope de duración
// SKIPPED  no arrancó porque la anterior seguía corriendo
enum JobResult {
  SUCCESS
  FAILURE
  SKIPPED
}

// Registro de ejecuciones. Existe en la base y no en los registros del
// contenedor porque la pregunta que hay que poder responder —"¿cuándo corrió
// bien por última vez?"— tiene que sobrevivir a la rotación de logs.
//
// Una fila con `finishedAt` nulo es una ejecución que MURIÓ A MITAD: se escribe
// al iniciar y se completa al terminar, precisamente para que eso se distinga
// de una que nunca empezó.
model JobRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  result     JobResult
  summary    String?
  error      String?

  @@index([job, startedAt])
  @@index([job, result, finishedAt])
  @@map("job_runs")
}
