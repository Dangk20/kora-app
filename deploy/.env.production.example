# Entorno de PRODUCCIÓN. Copiar a `.env.production` EN EL SERVIDOR y rellenar.
# El archivo real no se versiona jamás.
#
# ⚠️ Ningún valor de este archivo puede coincidir con el de pruebas. Que
# comprometer pruebas no entregue ninguna credencial válida aquí es un
# requisito verificado, no una buena intención (specs/environment-isolation).
#
# ⚠️ Ningún valor puede contener `$`: Docker Compose los interpreta como
# referencias a variables y entrega el valor truncado sin avisar de nada.
# Generar contraseñas con `openssl rand -base64 24 | tr -d '/+=$'`.

# ── Base de datos ────────────────────────────────────────────
# El host es el NOMBRE DEL SERVICIO en la red interna, no una IP ni localhost.
POSTGRES_USER=kora
POSTGRES_PASSWORD=
POSTGRES_DB=kora
DATABASE_URL=postgresql://kora:<misma-contraseña>@postgres:5432/kora

# ── Caché ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Sesión ───────────────────────────────────────────────────
# Generar con `openssl rand -base64 32`. Distinto del de producción: con el
# mismo secreto, una sesión de pruebas valdría en la tienda real.
AUTH_SECRET=
AUTH_TRUST_HOST=true

# ── Almacenamiento de imágenes ───────────────────────────────
# ⛔ BLOQUEANTE PARA EL GO-LIVE. La aplicación se NIEGA A ARRANCAR sin estas
# variables (src/instrumentation.ts, verificado): es deliberado, para que un
# error de configuración lo descubra el despliegue y no el primer cliente.
# Aquí NO valen valores de relleno: sin una cuenta real de Cloudflare R2 la
# tienda no puede mostrar una sola fotografía de producto.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── Imágenes de contenedor ───────────────────────────────────
# Las escribe el despliegue automático, etiquetadas con el hash del commit.
# Revertir es volver a levantar la etiqueta anterior.
KORA_IMAGE=kora-app:latest
KORA_MIGRATOR_IMAGE=kora-migrator:latest
