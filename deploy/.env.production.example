# Entorno de PRODUCCIÓN. Copiar a `.env.production` EN EL SERVIDOR y rellenar.
# El archivo real no se versiona jamás.
#
# ⚠️ Ningún valor de este archivo puede coincidir con el de pruebas. Que
# comprometer pruebas no entregue ninguna credencial válida aquí es un
# requisito verificado, no una buena intención (specs/environment-isolation).
#
# ⚠️ Ningún valor puede contener `$`: Docker Compose los interpreta como
# referencias a variables y entrega el valor truncado sin avisar de nada.
# Generar contraseñas con `openssl rand -base64 24 | tr -d '/+=$'`.
#
# ⚠️ Y todo valor con `<`, `>`, espacios o comillas va ENTRECOMILLADO. Docker
# lee este archivo con su propio analizador, pero `backup/respaldar.sh` le hace
# `source` como shell — y ahí `<` es una redirección. Pasó el 28 ago 2026:
# `EMAIL_FROM=KORA <no-responder@korashopp.com>` sin comillas dejaba la
# aplicación funcionando perfectamente y **el respaldo muerto** con un
# "syntax error near unexpected token". Un archivo que dos programas leen con
# reglas distintas rompe solo al que las tiene más estrictas. Comprobado: las
# comillas las quitan los dos, así que entrecomillar es seguro para ambos.
#
# ─────────────────────────────────────────────────────────────
# CUATRO GUARDAS DE ARRANQUE
# ─────────────────────────────────────────────────────────────
# La aplicación se NIEGA A LEVANTAR si falta cualquiera de los cuatro bloques
# marcados con ⛔ (`src/instrumentation.ts`). Es deliberado: cada uno de esos
# fallos, si se dejara pasar, produce un contenedor que se reporta sano y falla
# delante de un cliente —o peor, no falla y publica algo incorrecto.
#
# A diferencia de `docker-compose.staging.yml`, que declara su almacenamiento
# dentro del propio archivo, PRODUCCIÓN lo declara aquí. Ese reparto es a
# propósito, y tiene un coste: este archivo vive SOLO en el servidor, así que
# nadie ve en un diff lo que le falta. Por eso la lista de abajo tiene que
# estar completa — es el único sitio donde se puede consultar.

# ── Base de datos ────────────────────────────────────────────
# El host es el NOMBRE DEL SERVICIO en la red interna, no una IP ni localhost.
POSTGRES_USER=kora
POSTGRES_PASSWORD=
POSTGRES_DB=kora
DATABASE_URL=postgresql://kora:<misma-contraseña>@postgres:5432/kora

# ── Caché ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Sesión ───────────────────────────────────────────────────
# Generar con `openssl rand -base64 32`. Distinto del de pruebas: con el mismo
# secreto, una sesión de pruebas valdría en la tienda real.
AUTH_SECRET=
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://korashopp.com

# ── Qué entorno es este ──────────────────────────────────────
# "staging" hace que el correo se escriba a disco en vez de salir. Vacío o sin
# definir SE COMPORTA COMO PRODUCCIÓN: quien monte un entorno nuevo y lo olvide
# queda del lado seguro, no del que manda correo real sin querer.
KORA_ENV=production

# ── Enlaces dentro de los correos y del sitemap ──────────────
NEXT_PUBLIC_STORE_URL=https://korashopp.com

# ── ⛔ GUARDA 1 · Almacenamiento de imágenes ─────────────────
# Desde el 7 ago 2026 producción usa DISCO sobre un volumen de Docker, servido
# por /media/[...key]. R2 se descartó porque exige registrar una tarjeta.
#
# ⚠️ Aquí decía que /media va "detrás del CDN gratuito de Cloudflare" y NO es
# cierto (comprobado el 27 ago 2026): korashopp.com resuelve directo al VPS
# (2.24.90.21, servidor Caddy) con los DNS de parqueo de Hostinger, y no hay
# CDN delante de nada. Cada foto de producto la sirve esta máquina, con su
# ancho de banda y su CPU — tenerlo en cuenta cuando entre el catálogo real.
#
# No hay respaldo automático a otro driver, y eso es lo importante: antes, si
# faltaba una credencial de R2 la aplicación caía a disco EN SILENCIO, las
# fotos iban a la capa efímera del contenedor y el siguiente despliegue las
# borraba sin un solo error. Configuración incompleta = no arranca.
#
# KORA_UPLOADS_DIR debe COINCIDIR con el punto de montaje del volumen en
# docker-compose.prod.yml (`uploads:/data/uploads`). Si apunta a otro sitio,
# las imágenes viven dentro del contenedor y cada despliegue se las lleva.
KORA_STORAGE_DRIVER=disk
KORA_UPLOADS_DIR=/data/uploads

# Solo si algún día se vuelve a R2 (entonces KORA_STORAGE_DRIVER=r2 y estas
# cinco pasan a ser obligatorias). Volver es cambiar estas variables: las
# claves guardadas en la base no cambian de formato.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── ⛔ GUARDA 2 · Correo ─────────────────────────────────────
# Sin proveedor, el módulo de campañas y los siete comprobantes de pedido están
# rotos, y el fallo aparecería cuando alguien lanza la primera campaña —delante
# del cliente.
#
# ⚠️ INSUMO PENDIENTE DEL CLIENTE (desde el 31 jul 2026): además de la cuenta
# del proveedor, `korashopp.com` necesita SPF, DKIM y DMARC publicados. Sin
# ellos el correo sale y cae en spam, y cualquiera puede falsificar correos que
# digan venir de KORA.
RESEND_API_KEY=
EMAIL_FROM="KORA <no-responder@korashopp.com>"

# ── ⛔ GUARDA 3 · Datos del comerciante (páginas legales) ────
# Identifican al responsable del tratamiento en /legal/datos-personales, y por
# tanto sostienen la autorización que el checkout le pide al comprador.
#
# Publicar "[RAZÓN SOCIAL PENDIENTE]" no deja un texto incompleto: deja un
# consentimiento que no dice a quién se le entregan los datos, y no acredita
# nada ante la SIC (Ley 1581/2012, art. 9). No da error en ninguna pantalla.
#
# ⚠️ INSUMO PENDIENTE DEL CLIENTE. KORA_LEGAL_EMAIL tiene que ser un buzón que
# EXISTA: @korashopp.com todavía no recibe correo.
KORA_LEGAL_RAZON_SOCIAL=
KORA_LEGAL_NIT=
KORA_LEGAL_DOMICILIO=
KORA_LEGAL_EMAIL=

# ── ⛔ GUARDA 4 · Persistencia de las imágenes ───────────────
# No lleva variables: al arrancar se compara "imágenes que la base registra"
# contra "archivos en el disco" y no levanta si hay N y 0. Se documenta aquí
# porque es la guarda que más desconcierta cuando salta, y el mensaje de error
# lleva el comando para arreglarlo.
#
# Docker inicializa un volumen con nombre copiando el directorio de la imagen
# CON SU DUEÑO. El Dockerfile crea /data/uploads con dueño `node` para que los
# volúmenes nuevos nazcan bien; uno ya creado como root se corrige con:
#   docker run --rm -v kora-prod_uploads:/u alpine chown -R 1000:1000 /u

# ── Candado de Email marketing ───────────────────────────────
# El módulo está construido pero CERRADO hasta que el dominio pueda enviar.
# Se abre con "1"; sin definir queda cerrado, que es el lado inofensivo del
# error. No afecta a los comprobantes de pedido, que son otra vía.
KORA_MARKETING_ENABLED=

# ── Respaldos ────────────────────────────────────────────────
# Las lee `backup/respaldar.sh`, que corre en el ANFITRIÓN y no en un
# contenedor: la red de la base es `internal: true` y darle salida a internet a
# algo con acceso completo a ella crearía justo la ruta de exfiltración que ese
# aislamiento evita.
#
# KORA_BACKUP_AGE_RECIPIENT es la clave PÚBLICA. La privada NUNCA va al
# servidor: el servidor puede crear respaldos y no puede leerlos, así que
# comprometerlo no entrega además el histórico de datos de todos los clientes.
# ⚠️ Perder la clave privada hace los respaldos irrecuperables. Se custodia en
# dos sitios. Ver backup/README.md.
KORA_BACKUP_CONTAINER=kora-prod-postgres
KORA_BACKUP_REMOTE=respaldos:kora-respaldos/produccion
KORA_BACKUP_AGE_RECIPIENT=
KORA_BACKUP_RETENTION_DAYS=30
KORA_BACKUP_LOG=/var/log/kora-backup.log
KORA_BACKUP_UPLOADS_VOLUME=kora-prod_uploads

# ── Imágenes de contenedor ───────────────────────────────────
# Las escribe el despliegue automático, etiquetadas con el hash del commit.
# Revertir es volver a levantar la etiqueta anterior.
KORA_IMAGE=kora-app:latest
KORA_MIGRATOR_IMAGE=kora-migrator:latest
KORA_WORKER_IMAGE=kora-worker:latest
