# KORA — desarrollo local (NO commitear; ver .env.example)
DATABASE_URL="postgresql://kora:CHANGE_ME@localhost:5433/kora?schema=public"
REDIS_URL="redis://localhost:6380"

AUTH_SECRET="CHANGE_ME_openssl_rand_base64_32"
AUTH_TRUST_HOST=true

# Imágenes de producto (Cloudflare R2).
# Si estas variables están vacías, en desarrollo las imágenes se guardan en
# ./.uploads y se sirven por /media/*. En PRODUCCIÓN son obligatorias: el VPS
# nunca sirve imágenes de producto.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Base desechable para calcular migraciones (solo desarrollo).
# Créala una vez: docker exec kora-postgres psql -U kora -d kora -c "CREATE DATABASE kora_shadow;"
SHADOW_DATABASE_URL="postgresql://kora:CHANGE_ME@localhost:5433/kora_shadow?schema=public"

# ── Correo (S13) ────────────────────────────────────────────
# Sin estas variables, en PRODUCCIÓN la aplicación NO ARRANCA: un contenedor
# sano con el módulo de campañas roto haría que el fallo apareciera cuando
# alguien lanza la primera campaña, delante del cliente.
# En desarrollo no hacen falta: los correos se escriben en .emails/ y se abren.
# Además del proveedor, el dominio necesita SPF, DKIM y DMARC publicados.
# Qué entorno es este: "staging" o "production" (o vacío = producción).
# En pruebas el correo se ESCRIBE a disco en vez de salir, y la aplicación
# arranca sin proveedor. Sin definir se comporta como producción: si alguien
# monta un entorno nuevo y lo olvida, la guarda protege en vez de callarse.
KORA_ENV=""

# Dónde escribe los correos el driver de disco (desarrollo y pruebas).
EMAIL_DEV_DIR=""

RESEND_API_KEY=""
EMAIL_FROM="KORA <no-responder@korashopp.com>"
# Base pública de la tienda, para los enlaces dentro del correo.
NEXT_PUBLIC_STORE_URL="https://korashopp.com"

# ── Datos del comerciante (páginas legales) ─────────────────
# Identifican al responsable del tratamiento en /legal/datos-personales, y por
# tanto sostienen la autorización que el checkout le pide al comprador.
#
# Sin estas variables, en PRODUCCIÓN la aplicación NO ARRANCA. No es celo: una
# política publicada que dice "[RAZÓN SOCIAL PENDIENTE]" en el campo del
# responsable no es un texto incompleto, es un consentimiento que no identifica
# a quién se le entregan los datos — y no acredita nada ante la SIC
# (Ley 1581/2012, art. 9). El fallo no da error en ninguna pantalla.
#
# En desarrollo no hacen falta: se muestran marcadores entre corchetes.
# ⚠️ INSUMO PENDIENTE DEL CLIENTE al 7 ago 2026.
KORA_LEGAL_RAZON_SOCIAL=""
KORA_LEGAL_NIT=""
KORA_LEGAL_DOMICILIO=""
# Canal de atención al titular de datos. Tiene que ser un buzón que EXISTA:
# @korashopp.com todavía no recibe correo (Google Workspace quedó aplazado).
KORA_LEGAL_EMAIL=""
