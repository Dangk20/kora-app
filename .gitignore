# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# ...pero las PLANTILLAS sí se versionan: son la documentación de qué variables
# necesita cada entorno. Cubre .env.example, deploy/.env.edge.example,
# .env.staging.example y .env.production.example.
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Prisma client generado (se regenera con pnpm prisma generate)
/src/generated/

# Entorno local (plantilla en .env.example)
!.env.example

# Imágenes subidas en desarrollo (driver de disco). En producción van a R2.
/.uploads
# Correos escritos por el driver de desarrollo: llevan datos de compradores.
/.emails
/.legal
/.backup-keys
/.emails-test

# Claude Code: ajustes locales de la máquina (los comandos y skills de OpenSpec SÍ se versionan)
.claude/settings.local.json

# Credencial del entorno de pruebas: el archivo real vive solo en el servidor
# (plantilla versionada: deploy/auth.caddy.example)
deploy/auth.caddy

# Capturas y volcados de las verificaciones con navegador
.playwright-mcp/
.invoices/
